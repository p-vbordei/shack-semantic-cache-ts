{
  "name": "shack-semantic-cache",
  "version": "0.1.0",
  "description": "MCP server that caches tool-call results in a local SQLite database, using argument canonicalization so semantically equivalent inputs collide into the same cache entry.",
  "license": "Apache-2.0",
  "author": "Vlad Bordei <bordeivlad@gmail.com>",
  "type": "module",
  "bin": {
    "shack-semantic-cache": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".ts"],
    "testMatch": ["**/src/**/*.test.ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "diagnostics": {
            "ignoreCodes": [151002]
          }
        }
      ]
    }
  }
}
